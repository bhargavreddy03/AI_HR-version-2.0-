# ==============================================================================
# AI HR Intelligence Platform - Production / Staging Environment Template
# ==============================================================================
# For production or staging deployment, copy this file to .env and configure
# all mandatory high-entropy secrets:
#   cp .env.example .env
#
# Run production deployment:
#   docker compose --env-file .env -f infrastructure/docker/docker-compose.yml up -d
#
# FOR LOCAL DEVELOPMENT:
# - Do NOT use this template for local development.
# - Instead, copy .env.dev.example to .env.dev:
#     cp .env.dev.example .env.dev
#     docker compose --env-file .env.dev -f infrastructure/docker/docker-compose.yml -f infrastructure/docker/docker-compose.dev.yml up
#
# IMPORTANT:
# - NEVER commit sensitive credentials or real production secrets to version control.
# - All secrets and ENVIRONMENT below are empty placeholders and MUST be explicitly configured.
# - docker-compose.yml will fail immediately if required secrets are missing.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & General Configuration
# ------------------------------------------------------------------------------
# MUST be explicitly set to 'production' or 'staging' (fails if unset or empty)
ENVIRONMENT=
APP_NAME="AI HR Intelligence Platform"
APP_VERSION=2.0.0
DEBUG=false
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Networking & Host Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=["https://app.yourdomain.com"]

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Database Configuration (with pgvector)
# ------------------------------------------------------------------------------
# In production and staging, all passwords MUST be explicitly set to high-entropy secrets.
# Missing secrets will cause docker-compose and init-db.sh to immediately abort.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_hr_db

# Dedicated Restricted Runtime Application Role (NOSUPERUSER, NOBYPASSRLS, NOCREATEDB, NOCREATEROLE)
POSTGRES_USER=aihr_app_user
POSTGRES_PASSWORD=

# Privileged Migration / Schema Owner Role (For Alembic DDL migrations - NOSUPERUSER, NOBYPASSRLS, NOCREATEDB, NOCREATEROLE)
POSTGRES_MIGRATION_USER=aihr_migration_user
POSTGRES_MIGRATION_PASSWORD=

# Bootstrap Superuser (Docker initialization only)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Complete Runtime Database URL (FastAPI & Celery runtime)
# Example: postgresql+asyncpg://aihr_app_user:<POSTGRES_PASSWORD>@postgres:5432/ai_hr_db
DATABASE_URL=

# Complete Migration Database URLs (Alembic DDL execution)
# Example: postgresql+asyncpg://aihr_migration_user:<POSTGRES_MIGRATION_PASSWORD>@postgres:5432/ai_hr_db
DATABASE_MIGRATION_URL=
DATABASE_SYNC_URL=

# ------------------------------------------------------------------------------
# 4. Redis 7 Cache & Task Broker Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Celery Task Queue Settings
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ------------------------------------------------------------------------------
# 5. Security, Cryptography & JWT Configuration
# ------------------------------------------------------------------------------
# Minimum 32-character high-entropy secret keys required in staging/production
JWT_SECRET_KEY=
MFA_ENCRYPTION_KEY=
BACKUP_CODE_PEPPER=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session & Cookie Security
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ------------------------------------------------------------------------------
# 6. Storage & Cloud Provider Configuration (AWS S3)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_RESUMES=ai-hr-resumes
S3_BUCKET_REPORTS=ai-hr-reports
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# ------------------------------------------------------------------------------
# 7. AI & LLM Model Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL_NAME=gpt-4o-mini
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 8. Frontend Environment Configuration (Next.js Public Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI HR Intelligence Platform"
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api/v1
NEXT_PUBLIC_ENVIRONMENT=production
