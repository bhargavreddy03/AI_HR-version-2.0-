# ==============================================================================
# AI HR Intelligence Platform - Host-Based Local Development Template
# ==============================================================================
# Use this template when running FastAPI / Uvicorn directly on your local host
# machine (outside Docker containers) with PostgreSQL & Redis running locally.
#
# Usage:
#   cp .env.local.example .env
#   cd backend && uvicorn app.main:app --reload
#
# FOR DOCKER COMPOSE DEVELOPMENT:
#   Use .env.dev.example instead (configured with container hostnames postgres/redis).
#
# IMPORTANT:
# - Pre-configured credentials below are for LOCAL HOST DEVELOPMENT ONLY.
# - NEVER use these credentials in staging or production.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & General Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME="AI HR Intelligence Platform"
APP_VERSION=2.0.0
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Networking & Host Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Database Configuration (Host Networking: localhost)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_hr_db

# Bootstrap Superuser
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local_development_super_password_only

# Dedicated Restricted Runtime Application Role (NOSUPERUSER, NOBYPASSRLS, NOCREATEDB, NOCREATEROLE)
POSTGRES_APP_USER=aihr_app_user
POSTGRES_USER=aihr_app_user
POSTGRES_PASSWORD=local_development_password_only

# Privileged Migration / Schema Owner Role (For Alembic DDL migrations)
POSTGRES_MIGRATION_USER=aihr_migration_user
POSTGRES_MIGRATION_PASSWORD=local_development_migration_password_only

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Complete Runtime Database URL (Host -> localhost:5432)
DATABASE_URL=postgresql+asyncpg://aihr_app_user:local_development_password_only@localhost:5432/ai_hr_db

# Complete Migration Database URLs (Alembic DDL execution)
DATABASE_MIGRATION_URL=postgresql+asyncpg://aihr_migration_user:local_development_migration_password_only@localhost:5432/ai_hr_db
DATABASE_SYNC_URL=postgresql://aihr_migration_user:local_development_migration_password_only@localhost:5432/ai_hr_db

# ------------------------------------------------------------------------------
# 4. Redis 7 Cache & Task Broker Configuration (Host Networking: localhost)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local_development_redis_secret_only
REDIS_DB=0
REDIS_URL=redis://:local_development_redis_secret_only@localhost:6379/0

# Celery Task Queue Settings
CELERY_BROKER_URL=redis://:local_development_redis_secret_only@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:local_development_redis_secret_only@localhost:6379/2

# ------------------------------------------------------------------------------
# 5. Security, Cryptography & JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=local_development_jwt_secret_key_minimum_32_characters_long_for_security
MFA_ENCRYPTION_KEY=local_development_mfa_encryption_key_minimum_32_characters_for_security
BACKUP_CODE_PEPPER=local_development_backup_code_pepper_minimum_32_characters_for_security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session & Cookie Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# 6. Storage & Cloud Provider Configuration (AWS S3)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_RESUMES=ai-hr-resumes-local
S3_BUCKET_REPORTS=ai-hr-reports-local
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# ------------------------------------------------------------------------------
# 7. AI & LLM Model Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL_NAME=gpt-4o-mini
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 8. Frontend Environment Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI HR Intelligence Platform"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENVIRONMENT=development
