# ==============================================================================
# AI HR Intelligence Platform - Local Development Environment Template
# ==============================================================================
# Copy this file to .env.dev for local development:
#   cp .env.dev.example .env.dev
#
# Run local development with Compose:
#   docker compose --env-file .env.dev -f infrastructure/docker/docker-compose.yml -f infrastructure/docker/docker-compose.dev.yml up
#
# IMPORTANT:
# - This template contains pre-configured credentials for LOCAL DEVELOPMENT ONLY.
# - NEVER use these development credentials in staging or production.
# ==============================================================================

# Relative path to this env file from infrastructure/docker/ for Compose services
ENV_FILE=../../.env.dev

# ------------------------------------------------------------------------------
# 1. Environment & General Configuration
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME="AI HR Intelligence Platform"
APP_VERSION=2.0.0
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Networking & Host Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Database Configuration (with pgvector)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_hr_db

# Dedicated Restricted Runtime Application Role (NOSUPERUSER, NOBYPASSRLS, NOCREATEDB, NOCREATEROLE)
POSTGRES_USER=aihr_app_user
POSTGRES_PASSWORD=local_development_password_only

# Privileged Migration / Schema Owner Role (For Alembic DDL migrations - NOSUPERUSER, NOBYPASSRLS, NOCREATEDB, NOCREATEROLE)
POSTGRES_MIGRATION_USER=aihr_migration_user
POSTGRES_MIGRATION_PASSWORD=local_development_migration_password_only

# Bootstrap Superuser (Docker initialization only)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=local_development_super_password_only

# Database Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Complete Runtime Database URL (FastAPI & Celery runtime)
DATABASE_URL=postgresql+asyncpg://aihr_app_user:local_development_password_only@localhost:5432/ai_hr_db

# Complete Migration Database URLs (Alembic DDL execution)
DATABASE_MIGRATION_URL=postgresql+asyncpg://aihr_migration_user:local_development_migration_password_only@localhost:5432/ai_hr_db
DATABASE_SYNC_URL=postgresql://aihr_migration_user:local_development_migration_password_only@localhost:5432/ai_hr_db

# ------------------------------------------------------------------------------
# 4. Redis 7 Cache & Task Broker Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery Task Queue Settings
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. Security, Cryptography & JWT Configuration
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=local_development_jwt_secret_key_minimum_32_characters_long_for_security
MFA_ENCRYPTION_KEY=local_development_mfa_encryption_key_minimum_32_characters_for_security
BACKUP_CODE_PEPPER=local_development_backup_code_pepper_minimum_32_characters_for_security
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Session & Cookie Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=localhost

# ------------------------------------------------------------------------------
# 6. Storage & Cloud Provider Configuration (AWS S3)
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_RESUMES=ai-hr-resumes-local
S3_BUCKET_REPORTS=ai-hr-reports-local
S3_PRESIGNED_URL_EXPIRE_SECONDS=900

# ------------------------------------------------------------------------------
# 7. AI & LLM Model Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBEDDING_DIMENSION=1536
LLM_MODEL_NAME=gpt-4o-mini
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 8. Frontend Environment Configuration (Next.js Public Variables)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AI HR Intelligence Platform"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_ENVIRONMENT=development
